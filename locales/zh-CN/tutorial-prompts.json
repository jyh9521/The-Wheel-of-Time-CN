  "rows": [
    {
      "actor": "MessageTrigger6",
      "slot": 0,
      "source_sha256": "883652781554207d172e05e05227654ce705d50ce9d3cfde3d3a48c36e218d32",
      "translation": "研究特法器非常重要。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger6",
      "slot": 1,
      "source_sha256": "2087fbc77eeefc83099e150b3eb07202ffe8af136ffd012f94721b66e3908582",
      "translation": "每当拾取新的魔法器物，都应进行研究。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger6",
      "slot": 2,
      "source_sha256": "f004bbd2cf5e6bba0b92fd41051aacc19f827a4c72c97f38a25dee9caef6a997",
      "translation": "这里请按1选择气流冲击。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger6",
      "slot": 3,
      "source_sha256": "aae1edfdc6a73cf525d892048c9d074b8bebbc7834dc4c687576e785e17c739e",
      "translation": "按F2研究它。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger1",
      "slot": 2,
      "source_sha256": "1da5fa75578b6bbfa1d13a68d43466133fd0903ea86f16cba571a9c95289d045",
      "translation": " //你已与白塔缔结誓约。你准备好了。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger30",
      "slot": 0,
      "source_sha256": "4436c505fb61de330227f1b08606b0497615f3325b48ac4551a8659437cd3d27",
      "translation": "按主攻击键使用气流冲击。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger3",
      "slot": 0,
      "source_sha256": "6feff8dbd13d677b3c5ec8221c490a0b79b2181058440a49e9157badaaa35999",
      "translation": "按前进键向前移动［默认：上方向键］",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger3",
      "slot": 1,
      "source_sha256": "b68d821cc0788ceb7360496a5a4dbda119156dc92bedc599f706c8a8c89516eb",
      "translation": "按后退键向后移动［下方向键］",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger3",
      "slot": 2,
      "source_sha256": "fc7a61b80806cb391a29c63f7e24a71b5d9c91bc076b7a1eee83c3daa4e57ca0",
      "translation": "使用鼠标转向，或者",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger3",
      "slot": 3,
      "source_sha256": "cc4603a616624ead82a71f03e63450d085431a4baf5e6230d38556d708f574ff",
      "translation": "按左转键向左转［左方向键］",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger3",
      "slot": 4,
      "source_sha256": "53bb611727edf6206dd7ed2bad31b0c34a3f6e1341a8f5efff79ead27a7507d6",
      "translation": "按右转键向右转［右方向键］",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger28",
      "slot": 0,
      "source_sha256": "707a11708b71869d51e4decb646d1ff4f832f6bebb758913e3421f4bdf267d5c",
      "translation": "右上角的图标表示你拾取了新的魔法器物。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger28",
      "slot": 1,
      "source_sha256": "f6cbd6a5f51924e8742c6ea3d607173f6f4b280b41d054981af41180fbf46383",
      "translation": "这件气流冲击是你的默认特法器。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger49",
      "slot": 0,
      "source_sha256": "1e3b16801babde27c54917df6a10c666962b9f9c9653c4b08ab1dd6d3772694a",
      "translation": "朝梯子或某些墙壁移动，即可攀爬。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger49",
      "slot": 1,
      "source_sha256": "775ad012630db6aef1fe1387eca774e434b18a1ae522dc6141a9e0baaf657622",
      "translation": "面朝墙壁向前移动，爬出坑洞。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger27",
      "slot": 0,
      "source_sha256": "47835a14afda4061ba90e31343a12f8cac877d7e119d62c49b06afc1224a3f4d",
      "translation": "朝门移动，尝试将它推开。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger34",
      "slot": 0,
      "source_sha256": "67bfe949ed10b867c4e8634c13687a7668b4c01b4124419bc85802d79424a3f8",
      "translation": "你携带的所有钥匙都会显示在生命值下方。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger9",
      "slot": 0,
      "source_sha256": "537f8a350168820ced15a2959b5cfa5dfa317c0b409860d3af78ef59e2ec71fa",
      "translation": "按跳跃键原地起跳［鼠标右键或空格键］",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger9",
      "slot": 1,
      "source_sha256": "c3a37002943d4f4340119ce637696198a6b139ceae4bb352ab677012fa625ddf",
      "translation": "前进时按跳跃键，即可向前跳。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger16",
      "slot": 0,
      "source_sha256": "745be03c7057b9b8dee82060a95eec2a5cba85d8b0d8ba21eb9a04030bfce103",
      "translation": "所有有益效果都显示在生命值旁边。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger16",
      "slot": 1,
      "source_sha256": "8cc762cd8021bbf096a85d6d17da45232fbe5206d72b2343918f6d17ad5fdefe",
      "translation": "不利效果显示在右上角。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger41",
      "slot": 0,
      "source_sha256": "538e66ec338114b01e9cef8d692fa991cd2a9a0b56079ddd7a597a37d934bfd7",
      "translation": "按4选择瞬移特法器。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger41",
      "slot": 1,
      "source_sha256": "aae1edfdc6a73cf525d892048c9d074b8bebbc7834dc4c687576e785e17c739e",
      "translation": "按F2研究它。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger41",
      "slot": 2,
      "source_sha256": "7f1f0e33eaed00d5e3eb9feadef3e1ecbfece6ec4ffffe97d3cb5094921cdb92",
      "translation": "特法器的使用次数显示在图标下方。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger41",
      "slot": 3,
      "source_sha256": "b3f25e8e19baa163bd93424b93f82574b4f6d9750b38f064236d8f112f1ceeb8",
      "translation": "按攻击键使用瞬移。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger45",
      "slot": 0,
      "source_sha256": "5cd1bac288b99a4065168513db8eaa73e800271d8936ce76217a439d6851b379",
      "translation": "朝拉杆移动，即可扳动它。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger38",
      "slot": 0,
      "source_sha256": "2e58d641165765218e801a907dc9bbc675b086cc0e6273fb05b379c04efe4919",
      "translation": "魔法器物按用途分组，每组都有对应数字。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger38",
      "slot": 1,
      "source_sha256": "76c161c96849e0e6281db0c3c025cc4064b3d9d908b0793c44b61b0fcc6aa0f1",
      "translation": "按1切换该组中的气流冲击和火球。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger38",
      "slot": 2,
      "source_sha256": "490546d4a42f894f43e5e0655c89609b9482ce12b8066d85ded800fed650b9ae",
      "translation": "选中火球后停止切换。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger47",
      "slot": 0,
      "source_sha256": "64a98cd040421fe733897b55cea2aeb5e509859f56571751518815b3da1b7455",
      "translation": "按4选择反射特法器。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger5",
      "slot": 0,
      "source_sha256": "514cc10ef3034db56fa97657f6b847b6e20d4961a3c35fee9a3e51c03659951f",
      "translation": "进入危险区域时，按F5保存。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger5",
      "slot": 1,
      "source_sha256": "445a460d0b4b0e8cb2f4c0c798eef2850ff809cdc8c5e3961fed225c4f4f45eb",
      "translation": "按F6载入存档。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger42",
      "slot": 0,
      "source_sha256": "35d319f5d71f64da11496345ba1db5381a3b45a84798ffc009c72a6354c35f65",
      "translation": "按3选择火焰护盾特法器。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger39",
      "slot": 0,
      "source_sha256": "b66280f21a95bb54c4cbe946fec542ca967c4d9832636005baec2acf4580a444",
      "translation": "按方向键游泳。",
      "status": "draft"
    },
    {
      "actor": "MessageTrigger39",
      "slot": 1,
      "source_sha256": "2accb693b6f653ae92fff5f8d4207513b6d601fbc052720ecc72ec741036b770",
